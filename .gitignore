# ============================================
# Unity project .gitignore
# Tracked: Assets/, Packages/, ProjectSettings/ (+ .meta files)
# Everything Unity can regenerate is ignored.
# ============================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should always be kept (DO NOT ignore *.meta)
# Unity uses .meta files to keep GUID references between assets.

# Visual Studio / Rider / VS Code caches
/.vs/
/.vscode/
/.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated by Unity: auto-generated IDE/solution files
ExportedObj/
.consulo/

# Unity3D generated meta files for the above (not Assets)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash / log files
sysinfo.txt
mono_crash.*
*.log

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables / generated data (uncomment if you use them)
# /[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
# /[Aa]ssets/[Ss]treamingAssets/aa.meta
# /[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store
Thumbs.db
desktop.ini